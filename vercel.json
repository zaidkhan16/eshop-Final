{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/v2/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/config-check",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|config-check|static|favicon.ico|manifest.json|logo.*).*)",
      "destination": "/index.html"
    }
  ]
}
